# ============================================================
# DKSPORTS — Environment Variables Template
# Copy this file to .env and fill in your API keys.
# The app loads .env automatically via python-dotenv.
# ============================================================

# ---- football-data.org v4 (core data: leagues, teams, standings, scorers) ----
# Get your free key at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_key_here

# ---- apifootball.com (team/coach/squad photos) ----
# Get your key at: https://apifootball.com/pricing/
API_FOOTBALL_KEY=your_apifootball_key_here

# ---- TheSportsDB (real player and coach portraits, extra profile data) ----
# Free key is "123". Replace with your own premium key if you have one.
THESPORTSDB_API_KEY=123

# ---- The Odds API (live betting odds) ----
# Get your key at: https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# ---- football-news11 via RapidAPI (football news) ----
# Subscribe at: https://rapidapi.com/football-news11/api/football-news11
RAPIDAPI_FOOTBALL_NEWS_KEY=your_rapidapi_news_key_here

# ---- footapi7 via RapidAPI (shot maps, match statistics, lineups) ----
# Subscribe at: https://rapidapi.com/fluis.lacasse/api/footapi7
RAPIDAPI_FOOTAPI7_KEY=your_footapi7_key_here
# Endpoint: https://footapi7.p.rapidapi.com
# Available endpoints this key unlocks:
#   /api/match/{id}/shotmap        — shot positions, body parts, goal mouths
#   /api/match/{id}/statistics     — possession, passes, tackles, etc.
#   /api/match/{id}/incidents      — goals, cards, substitutions (timeline)
#   /api/match/{id}/lineups        — starting XIs and benches

# ---- ESPN-style league feeds via RapidAPI (extra player bio / league feeds) ----
# Used by english-premiere-league1 and similar providers.
RAPIDAPI_ESPN_SOCCER_KEY=your_rapidapi_espn_style_key_here

# ---- App settings ----
# PostgreSQL connection string used by db_client.py and init_db.py
# Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dksports
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Flask secret key for sessions (generate a long random string)
SESSION_SECRET=change_this_to_a_random_secret_string

# Port (default 5000; the Replit proxy handles public routing)
PORT=5000

# Set to 1 to force DB-first / local-asset-first rendering without live API fetches
OFFLINE_MODE=0

# ---- Virtual Game defaults ----
# House cut percentage (default 20%)
VIRTUAL_GAME_HOUSE_CUT=20
# Min/max bet amounts in local currency units
VIRTUAL_GAME_MIN_BET=25
VIRTUAL_GAME_MAX_BET=500
# Loading countdown duration (seconds)
VIRTUAL_GAME_COUNTDOWN=15
